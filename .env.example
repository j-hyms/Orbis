# Copiez ce fichier en ".env" puis remplissez les valeurs.

# Token du bot (Developer Portal > votre application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# Optionnel : ID de votre serveur de test.
# Rempli  -> les commandes apparaissent instantanément sur CE serveur.
# Vide    -> commandes globales (tous les serveurs, propagation jusqu'à 1 h).
GUILD_ID=
